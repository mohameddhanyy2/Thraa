# Copy to a local .env file and replace placeholders.
# Never commit real credentials or API keys.

NODE_ENV=development
PORT=3000

# Example local PostgreSQL connection. Each service should use its own
# database/schema according to the final team decision.
DATABASE_URL=postgresql://thraa_user:change_me@localhost:5432/thraa_identity?schema=public

# Use a strong random secret locally; configure secrets safely outside development.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m

# Optional market-data provider configuration
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=

# Optional Redis cache
REDIS_URL=redis://localhost:6379
QUOTE_CACHE_TTL_SECONDS=30
